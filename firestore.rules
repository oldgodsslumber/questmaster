rules_version = '2';

/* Questmaster security rules.
 *
 * Two principles the whole ruleset rests on:
 *
 *   1. You may only ever WRITE your own character document and its
 *      subcollections. There is no admin, no GM, and no granting things to
 *      other players. The single deliberate exception is toggling a task's
 *      completion on a co-op quest — see the tasks block below.
 *
 *   2. Reads widen with the party. A same-party member may read your sheet and
 *      any quest you have made visible to them; your journal stays yours.
 *
 * The party/quest-sharing rules are live even though the party UI ships later —
 * deploying them now means M5 needs no rules migration.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    /* Your own character doc, resolved server-side so a request cannot lie
     * about which party it belongs to. */
    function myChar() {
      return get(/databases/$(database)/documents/characters/$(request.auth.uid)).data;
    }
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    /* Same party, and not the degenerate "both have no party" case — otherwise
     * every partyless user would be able to read every other partyless user. */
    function samePartyAs(uid) {
      let theirs = get(/databases/$(database)/documents/characters/$(uid)).data;
      return signedIn()
        && theirs.partyId != null
        && myChar().partyId == theirs.partyId;
    }

    match /characters/{uid} {
      allow read: if isOwner(uid) || samePartyAs(uid);
      allow write: if isOwner(uid);

      /* Sheet subcollections: owner writes, party reads. Enumerated rather than
       * wildcarded, because a `/{sub}/{docId}` wildcard would also match
       * `quests` and `logbooks` and — since rules union rather than override —
       * would hand party members read access to private journals. */
      match /skills/{docId}       { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /equipment/{docId}    { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /items/{docId}        { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /spells/{docId}       { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /statuses/{docId}     { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /achievements/{docId} { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }
      match /traits/{docId}       { allow read: if isOwner(uid) || samePartyAs(uid); allow write: if isOwner(uid); }

      /* Journals are private, full stop. Sharing happens only by explicitly
       * posting an entry to the party feed, which is a separate document in a
       * separate collection. */
      match /logbooks/{logbookId} {
        allow read, write: if isOwner(uid);
        match /entries/{entryId} {
          allow read, write: if isOwner(uid);
        }
      }

      match /quests/{questId} {
        function quest() {
          return get(/databases/$(database)/documents/characters/$(uid)/quests/$(questId)).data;
        }
        function canView(q) {
          return isOwner(uid)
            || (q.visibility == 'party' && samePartyAs(uid))
            || (q.visibility == 'shared' && request.auth.uid in q.sharedWith);
        }

        allow read: if isOwner(uid) || canView(resource.data);
        /* Quest fields — title, cadence, visibility, bonus, streak — are the
         * owner's alone. A co-op partner completing tasks must not be able to
         * rewrite the quest they are helping with. */
        allow write: if isOwner(uid);

        match /tasks/{taskId} {
          allow read: if isOwner(uid) || canView(quest());

          allow create, delete: if isOwner(uid);

          /* The one non-owner write in the app. A co-op participant may flip a
           * task's completion and nothing else: every other field must come
           * back unchanged, so this cannot be used to inflate xpReward and then
           * claim it. */
          allow update: if isOwner(uid)
            || (
              quest().shareMode == 'coop'
              && canView(quest())
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['done', 'completedBy', 'completedAt'])
              && (request.resource.data.completedBy == request.auth.uid
                  || request.resource.data.completedBy == null)
            );
        }
      }
    }

    match /parties/{partyId} {
      function isMember() {
        return signedIn() && request.auth.uid in resource.data.memberUids;
      }

      /* Any signed-in user may read a party to resolve an invite code. Codes are
       * short and therefore guessable by design; a party contains no private
       * data beyond its roster, and joining is the intended outcome. */
      allow read: if signedIn();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() <= 8;

      /* Two legitimate updates, and nothing else:
       *   - an existing member changes the roster (including leaving), or
       *   - a NON-member joins by adding only themselves, and every current
       *     member is preserved (hasAll) so a stranger can't read a party and
       *     rewrite memberUids to eject everyone.
       * The old rule only checked the *result* contained the editor, which let
       * any signed-in user overwrite the whole roster. */
      allow update: if signedIn()
        && request.resource.data.memberUids.size() <= 8
        && (
          isMember()
          || (
            !(request.auth.uid in resource.data.memberUids)
            && request.auth.uid in request.resource.data.memberUids
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
          )
        );

      allow delete: if false;

      match /feed/{postId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberUids;
        allow create: if signedIn()
          && request.resource.data.authorUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/parties/$(partyId)).data.memberUids;
        allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
      }
    }
  }
}
